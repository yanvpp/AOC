-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=10;
DEPTH=256;

ADDRESS_RADIX=HEX;
DATA_RADIX=BIN;

CONTENT BEGIN
	000  :   0100000111;
	001  :   1000000000;
	002  :   1000001001;
	003  :   1000000011;
	004  :   1100000001;
	[005..006]  :   1000000000;
	007  :   1000001001;
	[008..0FF]  :   00XXXXXXXX;
END;
